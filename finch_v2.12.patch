+"""Pure-logic tests for main.py. Skipped automatically if fastapi/cohere are not installed."""
+import json
+import os
+
+try:
+    import main
+except Exception:  # pragma: no cover
+    main = None
+
+from analysis import analyze_dataset, build_ai_payload, prepare_dataframe, suggest_columns
+from sample_data import get_sample_dataframe
+
+
+def _facts():
+    c, n = prepare_dataframe(get_sample_dataframe())
+    s = suggest_columns(c)
+    return analyze_dataset(c, s["revenue"], s["cost"], s["category"], s["date"], n)
+
+
+def test_sanitize_keeps_scenario_margin():
+    if main is None:
+        return
+    out = main.sanitize_scenarios([{"scenario_name": "A", "revenue": 1.0, "costs": 1.0, "net_profit": 0.0, "profit_margin": 12.5}])
+    assert out[0]["margin"] == 12.5
+
+
+def test_masked_payload_stays_masked_through_the_backend():
+    if main is None:
+        return
+    payload = build_ai_payload(_facts(), mask=True)
+    prompt = main.build_prompt(main.sanitize_stats(payload), [], "₦")
+    for name in ("Rice", "Peak Milk", "Vegetable Oil", "Frozen Chicken"):
+        assert name not in prompt
+    assert "Category 1" in prompt and "cost_known" in prompt
+
+
+def test_payload_has_no_row_numbers():
+    if main is None:
+        return
+    stats = main.sanitize_stats(build_ai_payload(_facts()))
+    assert "row_index" not in json.dumps(stats)
+
+
+def test_rate_limit_blocks_after_limit():
+    if main is None:
+        return
+    os.environ["AI_RATE_PER_HOUR"] = "2"
+    main._user_hits.clear()
+    main.check_rate_limit("u1"); main.check_rate_limit("u1")
+    try:
+        main.check_rate_limit("u1")
+        raise AssertionError("should have been limited")
+    except main.HTTPException as e:
+        assert e.status_code == 429
+    main.check_rate_limit("u2")
diff -urN a/tests/test_database.py b/tests/test_database.py
--- a/tests/test_database.py	1970-01-01 01:00:00.000000000 +0100
+++ b/tests/test_database.py	2026-10-15 00:21:54.721583828 +0100
@@ -0,0 +1,178 @@
+import datetime
+import os
+import tempfile
+
+import database as db
+
+
+def fresh():
+    db.DB_PATH = os.path.join(tempfile.mkdtemp(), "t.duckdb")
+    db._initialised.clear()
+    db.init_db()
+
+
+def test_register_and_login():
+    fresh()
+    assert db.create_user("Ada", "ada@shop.ng", "Sunshine77")
+    assert not db.create_user("ada", "other@shop.ng", "Sunshine77")      # duplicate username
+    assert not db.create_user("bob", "ADA@shop.ng", "Sunshine77")        # duplicate email
+    assert db.verify_user("ADA", "Sunshine77") == "ada"
+    assert db.verify_user("ada@shop.ng", "Sunshine77") == "ada"
+    assert db.verify_user("ada", "wrong-pass") is None
+    assert db.verify_user("nobody", "Sunshine77") is None
+
+
+def test_weak_passwords_rejected():
+    fresh()
+    for bad in ("short1", "12345678", "password", "99999999"):
+        assert db.password_problem(bad)
+    assert not db.create_user("zed", "z@z.ng", "12345678")
+    assert db.password_problem("ada12345", "ada12345")
+    assert db.password_problem("Sunshine77", "ada") is None
+
+
+def test_lockout_after_five_failures():
+    fresh()
+    db.create_user("ada", "ada@shop.ng", "Sunshine77")
+    for _ in range(5):
+        assert db.verify_user("ada", "nope-nope") is None
+    assert db.login_locked("ada")
+    assert db.verify_user("ada", "Sunshine77") is None        # correct password still refused while locked
+    assert db.login_locked("ghost") is False
+    for _ in range(5):
+        db.verify_user("ghost", "x")
+    assert db.login_locked("ghost")                           # unknown names are throttled too
+
+
+def test_success_clears_failures():
+    fresh()
+    db.create_user("ada", "ada@shop.ng", "Sunshine77")
+    for _ in range(3):
+        db.verify_user("ada", "bad-bad-bad")
+    assert db.verify_user("ada", "Sunshine77") == "ada"
+    for _ in range(3):
+        db.verify_user("ada", "bad-bad-bad")
+    assert not db.login_locked("ada")
+
+
+def test_legacy_hash_still_works_and_is_upgraded():
+    fresh()
+    import hashlib
+    salt = "ab" * 16
+    legacy = hashlib.pbkdf2_hmac("sha256", b"OldPass123", bytes.fromhex(salt), 100000).hex()
+    with db.get_connection() as c:
+        c.execute("INSERT INTO tenants (username, email, password_hash, salt) VALUES (?, ?, ?, ?)",
+                  ["old", "old@x.ng", legacy, salt])
+    assert db.verify_user("old", "OldPass123") == "old"
+    with db.get_connection() as c:
+        stored = c.execute("SELECT password_hash FROM tenants WHERE username='old'").fetchone()[0]
+    assert stored.startswith("pbkdf2$200000$")
+    assert db.verify_user("old", "OldPass123") == "old"
+
+
+def test_sessions_expire_and_revoke():
+    fresh()
+    db.create_user("ada", "ada@shop.ng", "Sunshine77")
+    t = db.create_session("ada")
+    assert db.get_session_user(t) == "ada"
+    assert db.get_session_user("forged-token") is None and db.get_session_user("") is None
+    assert db.get_session_user("ada") is None                 # a username is NOT a valid token
+    db.delete_session(t)
+    assert db.get_session_user(t) is None
+    old = db.create_session("ada", hours=-1)
+    assert db.get_session_user(old) is None
+    with db.get_connection() as c:                             # only a hash is stored
+        assert t not in str(c.execute("SELECT * FROM sessions").fetchall())
+
+
+def test_password_reset_flow():
+    fresh()
+    db.create_user("ada", "ada@shop.ng", "Sunshine77")
+    s = db.create_session("ada")
+    assert db.create_reset_code("nobody") is None
+    user, code = db.create_reset_code("ada@shop.ng")
+    assert user == "ada"
+    assert not db.redeem_reset_code("ada", "WRONGCODE", "NewPass2026")
+    assert not db.redeem_reset_code("ada", code, "123")        # weak new password refused
+    assert db.redeem_reset_code("ada", code.lower(), "NewPass2026")
+    assert not db.redeem_reset_code("ada", code, "Another2026")  # one-time
+    assert db.verify_user("ada", "NewPass2026") == "ada" and db.verify_user("ada", "Sunshine77") is None
+    assert db.get_session_user(s) is None                      # old sessions revoked
+
+
+def test_reset_code_guessing_is_throttled():
+    fresh()
+    db.create_user("ada", "ada@shop.ng", "Sunshine77")
+    _, code = db.create_reset_code("ada")
+    for i in range(5):
+        assert not db.redeem_reset_code("ada", f"BAD{i}BAD0", "NewPass2026")
+    assert not db.redeem_reset_code("ada", code, "NewPass2026")
+
+
+def test_expired_reset_code():
+    fresh()
+    db.create_user("ada", "ada@shop.ng", "Sunshine77")
+    _, code = db.create_reset_code("ada")
+    with db.get_connection() as c:
+        c.execute("UPDATE reset_codes SET expires_at = ?", [datetime.datetime(2000, 1, 1)])
+    assert not db.redeem_reset_code("ada", code, "NewPass2026")
+
+
+def test_scenarios_roundtrip_and_isolation():
+    fresh()
+    db.save_scenario_db("ada", "Price +5%", "k1", {"revenue": 10.0, "costs": 5.0, "net_profit": 5.0, "profit_margin": 50.0, "cost_assumed": True})
+    db.save_scenario_db("ada", "Second", "k1", {"revenue": 1.0})
+    db.save_scenario_db("bob", "Bob's", "k1", {"revenue": 99.0})
+    got = db.load_scenarios_db("ada", "k1")
+    assert [g["scenario_name"] for g in got] == ["Price +5%", "Second"]
+    assert got[0]["margin"] == 50.0 and got[0]["cost_assumed"] is True
+    assert db.load_scenarios_db("ada", "other-file") == []
+    db.delete_scenarios_db("ada", "k1")
+    assert db.load_scenarios_db("ada", "k1") == [] and len(db.load_scenarios_db("bob", "k1")) == 1
+
+
+def test_history_keeps_unknown_profit_as_null():
+    fresh()
+    db.save_audit_history_db("a@x.ng", "Independent SME", "f.csv", {"total_revenue": 100.0, "net_profit": None, "profit_margin": None}, "s")
+    h = db.load_user_history_db("a@x.ng")
+    assert h[0]["net_profit"] is None and h[0]["total_revenue"] == 100.0
+    assert db.load_user_history_db("someone@else.ng") == []
+
+
+def test_export_and_delete_my_data():
+    fresh()
+    db.create_user("ada", "ada@shop.ng", "Sunshine77")
+    db.create_user("bob", "bob@shop.ng", "Sunshine88")
+    db.save_scenario_db("ada", "S", "k", {"revenue": 1.0})
+    db.save_scenario_db("bob", "B", "k", {"revenue": 2.0})
+    db.save_audit_history_db("ada@shop.ng", "x", "f.csv", {"total_revenue": 1.0}, "s")
+    db.save_audit_history_db("bob@shop.ng", "x", "g.csv", {"total_revenue": 2.0}, "s")
+    db.save_feedback_db("ada", "great")
+    tok = db.create_session("ada")
+    data = db.export_user_data("ada")
+    assert data["account"]["email"] == "ada@shop.ng" and len(data["scenarios"]) == 1 and len(data["reports"]) == 1
+    assert "password_hash" not in str(data) and "salt" not in str(data)
+    db.delete_user_data("ada")
+    assert db.verify_user("ada", "Sunshine77") is None and db.get_session_user(tok) is None
+    assert db.load_scenarios_db("ada", "k") == [] and db.load_user_history_db("ada@shop.ng") == []
+    assert len(db.load_scenarios_db("bob", "k")) == 1 and len(db.load_user_history_db("bob@shop.ng")) == 1
+    assert db.verify_user("bob", "Sunshine88") == "bob"
+
+
+def test_admin_overview_and_activity():
+    fresh()
+    db.create_user("ada", "ada@shop.ng", "Sunshine77")
+    db.log_tenant_activity("ada@shop.ng", "upload", increment_upload=True)
+    db.log_tenant_activity("ada@shop.ng", "upload", increment_upload=True)
+    rows = db.get_tenants_overview()
+    assert rows[0]["email"] == "ada@shop.ng" and rows[0]["total_uploads"] == 2
+
+
+def test_backup_creates_files():
+    import duckdb
+    if getattr(duckdb, "__SHIM__", False):
+        return  # needs real DuckDB (EXPORT DATABASE)
+    fresh()
+    db.create_user("ada", "ada@shop.ng", "Sunshine77")
+    path = db.backup_database(os.path.join(tempfile.mkdtemp(), "bk"))
+    assert os.path.exists(os.path.join(path, "schema.sql"))
diff -urN a/tests/test_deck.py b/tests/test_deck.py
--- a/tests/test_deck.py	1970-01-01 01:00:00.000000000 +0100
+++ b/tests/test_deck.py	2026-10-15 00:21:54.722250218 +0100
@@ -0,0 +1,47 @@
+import io
+
+from pptx import Presentation
+
+from analysis import analyze_dataset, prepare_dataframe, suggest_columns
+from deck_builder import build_actions, create_executive_deck
+from sample_data import get_sample_dataframe
+
+
+def facts_for(df):
+    clean, notes = prepare_dataframe(df)
+    s = suggest_columns(clean)
+    return analyze_dataset(clean, s["revenue"], s["cost"], s["category"], s["date"], notes)
+
+
+def slides(blob):
+    return Presentation(io.BytesIO(blob)).slides
+
+
+def test_full_deck_builds():
+    f = facts_for(get_sample_dataframe())
+    sc = [{"scenario_name": "Price +5%", "revenue": 1.0, "costs": 1.0, "net_profit": 0.0, "cost_assumed": False}]
+    assert len(slides(create_executive_deck(f, "₦", "shop.csv", sc))) == 8
+
+
+def test_deck_without_scenarios_has_seven_slides():
+    assert len(slides(create_executive_deck(facts_for(get_sample_dataframe()), "₦", "shop.csv", []))) == 7
+
+
+def test_deck_without_costs_category_or_date():
+    import pandas as pd
+    f = facts_for(pd.DataFrame({"Amount": [1, 2, 3]}))
+    assert len(slides(create_executive_deck(f, "$", "x.csv"))) >= 7
+
+
+def test_actions_follow_the_numbers():
+    f = facts_for(get_sample_dataframe())
+    titles = [t for t, _ in build_actions(f)]
+    assert 1 <= len(titles) <= 4
+    f["totals"]["cost_known"] = False
+    assert build_actions(f)[0][0] == "Add your costs"
+
+
+def test_deck_does_not_claim_verification():
+    blob = create_executive_deck(facts_for(get_sample_dataframe()), "₦", "shop.csv", [])
+    text = " ".join(sh.text_frame.text for s in slides(blob) for sh in s.shapes if sh.has_text_frame)
+    assert "Verified" not in text and "not been audited" in text
diff -urN a/tests/test_simulator.py b/tests/test_simulator.py
--- a/tests/test_simulator.py	1970-01-01 01:00:00.000000000 +0100
+++ b/tests/test_simulator.py	2026-10-15 00:21:54.722137115 +0100
@@ -0,0 +1,24 @@
+from simulator import calculate_scenario, generate_sensitivity_matrix
+
+T = {"total_revenue": 1000.0, "total_costs": 600.0}
+
+
+def test_no_change_is_baseline():
+    r = calculate_scenario(T, 0, 0, 0, 0, 0.3)
+    assert r["revenue"] == 1000 and r["costs"] == 600 and r["net_profit"] == 400 and r["profit_delta"] == 0
+
+
+def test_price_rise_cuts_volume_by_elasticity():
+    r = calculate_scenario(T, 10, 0, 0, 0, 0.3, elasticity=1.2)
+    assert round(r["volume_change_pct"], 6) == -12.0
+    assert round(r["revenue"], 6) == round(1000 * 1.10 * 0.88, 6)
+
+
+def test_unknown_costs_do_not_crash():
+    r = calculate_scenario({"total_revenue": 500.0, "total_costs": None}, 5, 0, 0, 0, 0.3)
+    assert r["costs"] == 0 and r["net_profit"] == r["revenue"]
+
+
+def test_matrix_shape():
+    m = generate_sensitivity_matrix(T, 0.3)
+    assert len(m) == 5 and len(m[0]) == 6
