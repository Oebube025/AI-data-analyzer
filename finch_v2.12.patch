+"""
+analysis.py - FINCH Data Analysis & Parsing Engine (v2.12)
+
+What changed vs v2.11
+- Strict number parsing: dates ("05/01/2026"), product names ("Peak Milk 400g") and
+  codes are never mistaken for money columns.
+- Column guessing prefers Total/Amount/Revenue over Unit Price, calculates
+  Quantity x Unit Price only when no total column exists, and never picks a Date
+  as the category.
+- Category names are grouped ignoring case/extra spaces ("rice" == "Rice ").
+- Unreadable revenue cells and negative values are reported as warnings.
+- Unknown costs are None (not 0.0), so nothing downstream can show a fake profit.
+- mask_ai_payload() really anonymises category names before anything is sent to the AI.
+"""
+import copy
+import re
+
+import numpy as np
+import pandas as pd
+
+# Column-name patterns. Lookarounds (not \b) so "order_id" and "Unit_Price" split on "_".
+_SEP_L, _SEP_R = r"(?<![a-z0-9])", r"(?![a-z0-9])"
+FORBIDDEN_COL_PATTERNS = re.compile(
+    _SEP_L + r"(id|code|zip|phone|status|email|year|month|day|index|ref|reference|no|num|number|serial|sn)" + _SEP_R,
+    re.IGNORECASE,
+)
+REV_INCLUDE = re.compile(r"revenue|sales|turnover|income|gross|paid|amount|total|takings|proceeds", re.I)
+REV_EXCLUDE = re.compile(
+    r"cost|expense|cogs|spend|qty|quantity|unit|price|rate|discount|tax|vat|profit|margin|balance|change|stock|reorder",
+    re.I,
+)
+PRICE_RE = re.compile(r"price|rate|selling", re.I)
+TOTALISH_RE = re.compile(r"total|amount|revenue|sales", re.I)
+QTY_RE = re.compile(r"qty|quantity|pcs|pieces|units?\s*sold|no\.?\s*of\s*units|volume", re.I)
+COST_RE = re.compile(r"cost|expense|cogs|spend|outgoing", re.I)
+UNIT_COST_RE = re.compile(r"unit|per|each", re.I)
+CAT_NAME_RE = re.compile(
+    r"category|department|region|product|item|store|client|customer|branch|type|service|description|name|"
+    r"particulars|details|channel|location|supplier",
+    re.I,
+)
+DATE_NAME_RE = re.compile(r"date|time|created|timestamp|period", re.I)
+_TOTAL_ROW_RE = r"^(grand\s+total|overall\s+total|sub\s*total|totals?|sum)\s*:?$"
+
+
+# --------------------------------------------------------------------------- parsing
+def parse_numeric_series(series: pd.Series) -> pd.Series:
+    """Parse money-like values strictly. Anything that is not clearly a number becomes NaN.
+
+    Handles: 5000, "5,000", "₦5,000.50", "(1,200)" (negative), "NGN 3000", "1.234,50".
+    Rejects: "05/01/2026", "Rice (50kg)", "400g", "N/A".
+    """
+    if pd.api.types.is_bool_dtype(series):
+        return pd.Series(np.nan, index=series.index)
+    if pd.api.types.is_numeric_dtype(series):
+        return pd.to_numeric(series, errors="coerce").astype("float64")
+    if pd.api.types.is_datetime64_any_dtype(series):
+        return pd.Series(np.nan, index=series.index)
+
+    s = series.astype("string").str.strip()
+    neg = s.str.match(r"^\(.*\)$").fillna(False).to_numpy(dtype=bool)
+    s = s.str.replace(r"^\((.*)\)$", r"\1", regex=True)
+    s = s.str.replace(r"(?i)ngn|usd|eur|gbp|[₦$€£]", "", regex=True).str.replace(r"\s+", "", regex=True)
+    # European style (1.234,50): decide once per column so "999,99" in the same column is read consistently.
+    if s.str.match(r"^-?\d{1,3}(\.\d{3})+,\d+$").fillna(False).any():
+        s = s.str.replace(".", "", regex=False).str.replace(",", ".", regex=False)
+    s = s.str.replace(",", "", regex=False)
+    ok = s.str.fullmatch(r"-?(\d+(\.\d+)?|\.\d+)").fillna(False)
+    out = pd.to_numeric(s.where(ok), errors="coerce").astype("float64")
+    out = pd.Series(np.where(neg, -np.abs(out.to_numpy()), out.to_numpy()), index=series.index)
+    return out
+
+
+def _is_date_like(series: pd.Series, name: str) -> bool:
+    if pd.api.types.is_datetime64_any_dtype(series):
+        return True
+    if pd.api.types.is_numeric_dtype(series):
+        return False
+    if DATE_NAME_RE.search(name):
+        return True
+    sample = series.dropna().astype(str).head(30)
+    if sample.empty:
+        return False
+    parsed = pd.to_datetime(sample, errors="coerce", dayfirst=True, format="mixed")
+    return parsed.notna().mean() >= 0.8
+
+
+def prepare_dataframe(df: pd.DataFrame):
+    """Trim headers, drop empty rows/columns and summary ("Total") rows."""
+    notes = []
+    out = df.copy()
+    out.columns = [str(c).strip() for c in out.columns]
+
+    empty_cols = [c for c in out.columns if out[c].isna().all()]
+    if empty_cols:
+        out = out.drop(columns=empty_cols)
+        notes.append(f"Ignored {len(empty_cols)} empty column(s).")
+
+    before = len(out)
+    out = out.dropna(how="all")
+    if len(out) < before:
+        notes.append(f"Removed {before - len(out)} empty row(s).")
+
+    mask = pd.Series(False, index=out.index)
+    for col in out.columns:
+        if not pd.api.types.is_numeric_dtype(out[col]):
+            cell = out[col].astype("string").str.strip().str.lower()
+            mask = mask | cell.str.match(_TOTAL_ROW_RE).fillna(False)
+    if mask.any():
+        out = out[~mask]
+        notes.append(f"Removed {int(mask.sum())} summary/total row(s) so they are not counted twice.")
+
+    return out.reset_index(drop=True), notes
+
+
+def valid_numeric_columns(df: pd.DataFrame) -> list:
+    valid = []
+    for col in df.columns:
+        if FORBIDDEN_COL_PATTERNS.search(col):
+            continue
+        if pd.api.types.is_datetime64_any_dtype(df[col]) or pd.api.types.is_bool_dtype(df[col]):
+            continue
+        non_null = int(df[col].notna().sum())
+        if non_null == 0:
+            continue
+        parsed_ok = int(parse_numeric_series(df[col]).notna().sum())
+        if parsed_ok > 0 and parsed_ok / non_null >= 0.6:
+            valid.append(col)
+    return valid
+
+
+# --------------------------------------------------------------------------- column guessing
+def find_qty_column(df: pd.DataFrame, exclude=()):
+    for c in valid_numeric_columns(df):
+        if c in exclude:
+            continue
+        if QTY_RE.search(c) and not PRICE_RE.search(c) and not COST_RE.search(c):
+            return c
+    return None
+
+
+def _is_unit_price(col: str) -> bool:
+    return bool(PRICE_RE.search(col)) and not TOTALISH_RE.search(col)
+
+
+def _is_unit_cost(col: str) -> bool:
+    return bool(COST_RE.search(col)) and bool(UNIT_COST_RE.search(col)) and not re.search(r"total", col, re.I)
+
+
+def _pick_revenue(nums: list):
+    tier1 = [c for c in nums if REV_INCLUDE.search(c) and not REV_EXCLUDE.search(c)]
+    for pattern in (r"total", r"revenue|sales|turnover|takings|proceeds", r"amount|income|gross|paid"):
+        for c in tier1:
+            if re.search(pattern, c, re.I):
+                return c
+    if tier1:
+        return tier1[0]
+    for c in nums:  # price column: analyze_dataset multiplies by quantity
+        if PRICE_RE.search(c) and not COST_RE.search(c):
+            return c
+    for c in nums:
+        if not QTY_RE.search(c) and not COST_RE.search(c):
+            return c
+    return nums[0] if nums else None
+
+
+def _pick_cost(nums: list, revenue_col):
+    cands = [c for c in nums if c != revenue_col and COST_RE.search(c)]
+    if not cands:
+        return "None"
+    for c in cands:
+        if re.search(r"total", c, re.I):
+            return c
+    for c in cands:
+        if not UNIT_COST_RE.search(c):
+            return c
+    return cands[0]
+
+
+def suggest_columns(df: pd.DataFrame) -> dict:
+    nums = valid_numeric_columns(df)
+    rev = _pick_revenue(nums)
+    cost = _pick_cost(nums, rev)
+
+    date_col = "None"
+    for c in df.columns:
+        if c in nums and not DATE_NAME_RE.search(c):
+            continue
+        if _is_date_like(df[c], c):
+            date_col = c
+            break
+
+    text_cols = [c for c in df.columns
+                 if c not in nums and c != date_col
+                 and not pd.api.types.is_numeric_dtype(df[c])
+                 and not _is_date_like(df[c], c)
+                 and not FORBIDDEN_COL_PATTERNS.search(c)]
+    cat = "None"
+    for c in text_cols:
+        if CAT_NAME_RE.search(c):
+            cat = c
+            break
+    if cat == "None":
+        for c in text_cols:
+            n = df[c].nunique(dropna=True)
+            if 1 < n <= max(30, int(0.5 * len(df))):
+                cat = c
+                break
+
+    return {"revenue": rev if rev else "None", "cost": cost, "category": cat, "date": date_col,
+            "qty": find_qty_column(df, exclude=(rev, cost)) or "None"}
+
+
+# --------------------------------------------------------------------------- analysis
+def _labelled_concentration(rbc: dict, total_revenue: float) -> dict:
+    if not rbc:
+        return {"top_category": "N/A", "share_pct": 0.0, "share": "No category column selected"}
+    top_name, top_val = next(iter(rbc.items()))
+    share = (top_val / total_revenue * 100) if total_revenue > 0 else 0.0
+    if len(rbc) == 1:
+        label = f"Only one category ({top_name})"
+    elif share > 50:
+        label = f"High ({share:.1f}% from {top_name})"
+    elif share > 30:
+        label = f"Moderate ({share:.1f}% from {top_name})"
+    else:
+        label = f"Low ({share:.1f}% from {top_name})"
+    return {"top_category": top_name, "share_pct": float(share), "share": label}
+
+
+def analyze_dataset(df: pd.DataFrame, revenue_col: str, cost_col: str = "None",
+                    category_col: str = "None", date_col: str = "None", prep_notes: list = None) -> dict:
+    if revenue_col not in df.columns:
+        raise ValueError(f"Revenue column '{revenue_col}' not found.")
+    notes = list(prep_notes or [])
+    warnings = []
+    n = len(df)
+
+    raw_rev = parse_numeric_series(df[revenue_col])
+    unreadable = int((raw_rev.isna() & df[revenue_col].notna()).sum())
+    rev = raw_rev.fillna(0.0).to_numpy(dtype=float)
+
+    qty_col = find_qty_column(df, exclude=(revenue_col, cost_col))
+    if _is_unit_price(revenue_col) and qty_col:
+        qty = parse_numeric_series(df[qty_col]).fillna(0.0).to_numpy(dtype=float)
+        rev = rev * qty
+        notes.append(f"Revenue was calculated as {qty_col} x {revenue_col} for each row.")
+
+    total_revenue = float(rev.sum())
+
+    cost_known, total_costs, net_profit, profit_margin = False, None, None, None
+    if cost_col not in (None, "None") and cost_col in df.columns:
+        raw_cost = parse_numeric_series(df[cost_col])
+        unreadable += int((raw_cost.isna() & df[cost_col].notna()).sum())
+        cost = raw_cost.fillna(0.0).to_numpy(dtype=float)
+        if _is_unit_cost(cost_col) and qty_col:
+            cost = cost * parse_numeric_series(df[qty_col]).fillna(0.0).to_numpy(dtype=float)
+            notes.append(f"Costs were calculated as {qty_col} x {cost_col} for each row.")
+        total_costs = float(cost.sum())
+        net_profit = total_revenue - total_costs
+        profit_margin = (net_profit / total_revenue * 100) if total_revenue > 0 else None
+        cost_known = True
+
+    missing_cells = int(df.isna().sum().sum())
+    duplicate_rows = int(df.duplicated().sum())
+    cells = max(1, n * max(1, len(df.columns)))
+    health = max(0, 100 - int(missing_cells / cells * 50) - int(duplicate_rows / max(1, n) * 50))
+
+    # Categories: group ignoring case and stray spaces, show the most common spelling.
+    revenue_by_category = {}
+    if category_col not in (None, "None") and category_col in df.columns:
+        label = df[category_col].astype("string").str.strip().fillna("(blank)").to_numpy(dtype=object)
+        key = np.array([str(x).casefold() for x in label], dtype=object)
+        frame = pd.DataFrame({"key": key, "label": label, "rev": rev})
+        names = frame.groupby("key")["label"].agg(lambda s: s.value_counts().index[0])
+        sums = frame.groupby("key")["rev"].sum().sort_values(ascending=False)
+        revenue_by_category = {str(names[k]): float(v) for k, v in sums.items()}
+
+    concentration = _labelled_concentration(revenue_by_category, total_revenue)
+    items = list(revenue_by_category.items())
+    leaderboards = {
+        "top": [[k, v] for k, v in items[:5]],
+        "bottom": [[k, v] for k, v in items[-3:]] if len(items) > 5 else [],
+    }
+
+    # Trend
+    trend = {"granularity": "none", "points": [], "change_pct": None}
+    if date_col not in (None, "None") and date_col in df.columns:
+        dates = df[date_col] if pd.api.types.is_datetime64_any_dtype(df[date_col]) else \
+            pd.to_datetime(df[date_col], errors="coerce", dayfirst=True, format="mixed")
+        ok = dates.notna().to_numpy()
+        if ok.mean() < 0.8 and n:
+            warnings.append(f"Only {ok.mean()*100:.0f}% of the dates in '{date_col}' could be read, so the trend may be incomplete.")
+        if ok.any():
+            tdf = pd.DataFrame({"date": dates.to_numpy()[ok], "rev": rev[ok]})
+            months = tdf.groupby(pd.to_datetime(tdf["date"]).dt.to_period("M"))["rev"].sum()
+            if len(months) == 1 and pd.to_datetime(tdf["date"]).dt.normalize().nunique() >= 7:
+                days = tdf.groupby(pd.to_datetime(tdf["date"]).dt.normalize())["rev"].sum()
+                trend = {"granularity": "Day",
+                         "points": [{"period": d.strftime("%Y-%m-%d"), "revenue": float(v)} for d, v in days.items()],
+                         "change_pct": None}
+            else:
+                vals = [float(v) for v in months.values]
+                change = None
+                if len(vals) >= 2 and vals[-2] > 0:
+                    change = float((vals[-1] - vals[-2]) / vals[-2] * 100)
+                trend = {"granularity": "Month",
+                         "points": [{"period": str(p), "revenue": float(v)} for p, v in months.items()],
+                         "change_pct": change}
+
+    # Outliers (IQR rule on the revenue per row)
+    anomalies, anomaly_count = [], 0
+    if n > 5:
+        q1, q3 = np.percentile(rev, [25, 75])
+        iqr = q3 - q1
+        if iqr > 0:
+            idx = np.where(rev > q3 + 1.5 * iqr)[0]
+            anomaly_count = int(len(idx))
+            cat_vals = df[category_col].astype(str).to_numpy() if category_col in df.columns else None
+            for i in idx[np.argsort(-rev[idx])][:10]:
+                anomalies.append({"row_index": int(i), "revenue": float(rev[i]),
+                                  "category": str(cat_vals[i]) if cat_vals is not None else "N/A"})
+
+    # Honest warnings
+    if unreadable:
+        warnings.append(f"{unreadable:,} cell(s) in your revenue/cost columns could not be read as numbers and were counted as 0.")
+    neg = int((rev < 0).sum())
+    if neg:
+        warnings.append(f"{neg:,} row(s) have negative revenue (refunds or returns?). They reduce your total.")
+    if missing_cells:
+        warnings.append(f"Your file has {missing_cells:,} empty cell(s).")
+    if duplicate_rows:
+        warnings.append(f"{duplicate_rows:,} row(s) are exact duplicates. Check they are not double entries.")
+    if not cost_known:
+        warnings.append("No cost column selected. Profit and margin are shown as n/a.")
+
+    return {
+        "totals": {"total_revenue": total_revenue, "total_costs": total_costs, "net_profit": net_profit,
+                   "profit_margin": profit_margin, "cost_known": cost_known},
+        "metadata": {"total_records": n, "total_rows": n, "data_health_index": health,
+                     "missing_cells": missing_cells, "duplicate_rows": duplicate_rows,
+                     "anomaly_count": anomaly_count, "revenue_column": revenue_col, "cost_column": cost_col,
+                     "category_column": category_col, "date_column": date_col},
+        "trend": trend,
+        "revenue_by_category": revenue_by_category,
+        "leaderboards": leaderboards,
+        "concentration": concentration,
+        "anomalies": anomalies,
+        "anomaly_summary": f"{anomaly_count} unusually large row(s) found (above the normal range for your data).",
+        "warnings": warnings,
+        "preparation_notes": notes,
+    }
+
+
+# --------------------------------------------------------------------------- AI payload
+def mask_ai_payload(payload: dict) -> dict:
+    """Return a copy where every category name is replaced by 'Category N'."""
+    out = copy.deepcopy(payload)
+    names = list((out.get("revenue_by_category") or {}).keys())
+    for group in (out.get("leaderboards") or {}).values():
+        for name, _ in group:
+            if name not in names:
+                names.append(name)
+    mapping = {nm: f"Category {i + 1}" for i, nm in enumerate(names)}
+    ordered = sorted(mapping, key=len, reverse=True)
+
+    def scrub(text):
+        if not isinstance(text, str):
+            return text
+        for nm in ordered:
+            text = text.replace(nm, mapping[nm])
+        return text
+
+    if out.get("revenue_by_category"):
+        out["revenue_by_category"] = {mapping[k]: v for k, v in out["revenue_by_category"].items()}
+    if out.get("leaderboards"):
+        out["leaderboards"] = {g: [[mapping.get(n, n), v] for n, v in rows] for g, rows in out["leaderboards"].items()}
+    if out.get("concentration"):
+        c = out["concentration"]
+        c["top_category"] = mapping.get(c.get("top_category"), c.get("top_category"))
+        c["share"] = scrub(c.get("share"))
+    out["warnings"] = [scrub(w) for w in out.get("warnings", [])]
+    return out
+
+
+def build_ai_payload(facts: dict, mask: bool = False) -> dict:
+    """Aggregates only. No raw rows, no row numbers, no per-row categories."""
+    payload = {
+        "metadata": facts.get("metadata"),
+        "totals": facts.get("totals"),
+        "revenue_by_category": dict(list((facts.get("revenue_by_category") or {}).items())[:15]),
+        "leaderboards": facts.get("leaderboards"),
+        "concentration": facts.get("concentration"),
+        "trend": facts.get("trend"),
+        "anomaly_summary": facts.get("anomaly_summary"),
+        "anomalies": [{"revenue": a["revenue"]} for a in facts.get("anomalies", [])[:5]],
+        "warnings": facts.get("warnings", []),
+    }
+    return mask_ai_payload(payload) if mask else payload
