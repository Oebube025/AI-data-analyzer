+import pandas as pd
+
+from analysis import (analyze_dataset, build_ai_payload, mask_ai_payload, parse_numeric_series,
+                      prepare_dataframe, suggest_columns, valid_numeric_columns)
+from sample_data import get_sample_dataframe
+
+
+def run(df, **override):
+    clean, notes = prepare_dataframe(df)
+    s = suggest_columns(clean)
+    s.update(override)
+    return analyze_dataset(clean, s["revenue"], s["cost"], s["category"], s["date"], notes), s
+
+
+def test_sample_data_is_read_correctly():
+    f, s = run(get_sample_dataframe())
+    assert s["revenue"] == "Total_Amount" and s["cost"] == "Total_Cost"
+    assert s["category"] == "Product" and s["date"] == "Date"
+    assert f["totals"]["total_revenue"] == 2_160_500
+    assert f["totals"]["total_costs"] == 1_710_000
+    assert f["totals"]["net_profit"] == 450_500
+    assert list(f["revenue_by_category"])[0] == "Rice (50kg)"
+    assert f["trend"]["granularity"] == "Month" and len(f["trend"]["points"]) == 3
+
+
+def test_dates_and_product_names_are_not_numeric():
+    df = get_sample_dataframe()
+    nums = valid_numeric_columns(df)
+    assert "Date" not in nums and "Product" not in nums
+
+
+def test_qty_times_unit_price_when_no_total():
+    df = pd.DataFrame({"Date": ["05/01/2026", "06/01/2026", "07/02/2026"], "Item": ["Rice", "Beans", "Soap"],
+                       "Qty": [10, 5, 20], "Unit Price": [500, 700, 300]})
+    f, s = run(df)
+    assert s["revenue"] == "Unit Price"
+    assert f["totals"]["total_revenue"] == 5000 + 3500 + 6000
+    assert f["totals"]["cost_known"] is False and f["totals"]["net_profit"] is None
+    assert f["totals"]["total_costs"] is None
+    assert s["category"] == "Item"
+
+
+def test_total_amount_beats_unit_price():
+    df = pd.DataFrame({"Qty": [1, 2], "Unit_Price": [100, 200], "Total_Amount": [100, 400]})
+    f, s = run(df)
+    assert s["revenue"] == "Total_Amount" and f["totals"]["total_revenue"] == 500
+
+
+def test_unit_cost_times_quantity():
+    df = pd.DataFrame({"Item": ["a", "b"], "Quantity": [2, 3], "Total_Amount": [1000, 900], "Unit_Cost": [100, 100]})
+    f, s = run(df)
+    assert s["cost"] == "Unit_Cost" and f["totals"]["total_costs"] == 500
+
+
+def test_total_row_and_text_amounts():
+    df = pd.DataFrame({"Date": ["05/01/2026", "06/02/2026", "07/02/2026", "Total"],
+                       "Item": ["Rice", "Soap", "Beans", "Total"],
+                       "Amount": ["₦5,000", "₦3,000", "₦3,500", "₦11,500"], "Cost": ["3,000", "2,000", "2,000", "7,000"]})
+    f, _ = run(df)
+    assert f["totals"]["total_revenue"] == 11_500 and f["totals"]["total_costs"] == 7_000
+    assert any("summary/total" in n for n in f["preparation_notes"])
+
+
+def test_blank_rows_keep_alignment():
+    df = pd.DataFrame({"Item": ["Rice", None, "Soap", "Beans"], "Amount": ["5,000", None, "3,000", "3,500"],
+                       "Cost": ["3,000", None, "2,000", "2,000"]})
+    f, _ = run(df)
+    assert f["revenue_by_category"] == {"Rice": 5000.0, "Beans": 3500.0, "Soap": 3000.0}
+
+
+def test_categories_ignore_case_and_spaces():
+    df = pd.DataFrame({"Product": ["Rice", " rice ", "RICE", "Soap"], "Amount": [10, 10, 10, 5]})
