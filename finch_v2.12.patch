+    "danger": RGBColor(185, 28, 28),
+    "gold": RGBColor(244, 184, 96),
+    "muted": RGBColor(100, 116, 139),
+    "light_text": RGBColor(248, 250, 252),
+}
+
+
+def _money(v, cur):
+    if v is None:
+        return "n/a"
+    return f"{cur}{v:,.0f}" if abs(v) >= 1000 else f"{cur}{v:,.2f}"
+
+
+def build_actions(facts: dict) -> list:
+    """Return up to 4 {title, desc} actions derived from the numbers."""
+    t, meta = facts.get("totals", {}), facts.get("metadata", {})
+    conc, trend = facts.get("concentration", {}) or {}, facts.get("trend", {}) or {}
+    actions = []
+    if not t.get("cost_known"):
+        actions.append(("Add your costs", "Your file has no cost column, so profit is unknown. Add costs to see what you really keep."))
+    else:
+        m = t.get("profit_margin")
+        if t.get("net_profit") is not None and t["net_profit"] < 0:
+            actions.append(("Stop the loss", "Costs are higher than sales. List your biggest costs and cut or renegotiate the top three."))
+        elif m is not None and m < 10:
+            actions.append(("Protect a thin margin", f"You keep about {m:.1f}% of each sale. A small cost rise could wipe out your profit."))
+    if (conc.get("share_pct") or 0) > 50 and conc.get("top_category") not in (None, "N/A"):
+        actions.append(("Reduce dependence on one line", f"{conc['top_category']} brings in {conc['share_pct']:.0f}% of sales. Grow a second product."))
+    chg = trend.get("change_pct")
+    if chg is not None and chg < -10:
+        actions.append(("Find out why sales dropped", f"Sales fell {abs(chg):.0f}% versus the previous month. Check stock, prices and customers."))
+    elif chg is not None and chg > 10:
+        actions.append(("Keep the momentum", f"Sales grew {chg:.0f}% versus the previous month. Make sure stock and staff can keep up."))
+    if meta.get("anomaly_count"):
+        actions.append(("Check unusually large sales", f"{meta['anomaly_count']} row(s) are far above normal. Confirm they are real and not typing mistakes."))
+    if meta.get("duplicate_rows") or meta.get("missing_cells"):
+        actions.append(("Clean your records", "There are empty cells or duplicate rows. Fix them so future reports are more accurate."))
+    for extra in (("Record every sale", "Daily records make every future report more accurate."),
+                  ("Review monthly", "Upload your file each month and compare against this report.")):
+        if len(actions) < 3:
+            actions.append(extra)
+    return actions[:4]
+
+
+def create_executive_deck(facts, currency="₦", filename="Dataset", scenarios=None):
+    prs = Presentation()
+    prs.slide_width, prs.slide_height = Inches(13.333), Inches(7.5)
+    blank = prs.slide_layouts[6]
+
+    totals, meta = facts.get("totals", {}), facts.get("metadata", {})
+    rbc, trend = facts.get("revenue_by_category", {}) or {}, facts.get("trend", {}) or {}
+    cost_known = bool(totals.get("cost_known"))
+    margin = totals.get("profit_margin")
+    margin_str = f"{margin:.1f}%" if margin is not None else "n/a"
+    today = datetime.date.today().strftime("%d %b %Y")
+    page = {"n": 0}
+
+    def background(slide, color):
+        slide.background.fill.solid()
+        slide.background.fill.fore_color.rgb = color
+
+    def text(slide, x, y, w, h, paragraphs):
+        tb = slide.shapes.add_textbox(Inches(x), Inches(y), Inches(w), Inches(h))
+        tf = tb.text_frame
+        tf.word_wrap = True
+        for i, (txt, size, bold, color) in enumerate(paragraphs):
+            p = tf.paragraphs[0] if i == 0 else tf.add_paragraph()
+            p.text = txt
+            p.font.size, p.font.bold, p.font.color.rgb = Pt(size), bold, color
+            p.space_after = Pt(8)
+        return tb
+
+    def new_slide(kicker, title, subtitle=""):
+        s = prs.slides.add_slide(blank)
+        page["n"] += 1
+        background(s, COLORS["bg_light"])
+        text(s, 0.8, 0.4, 11.5, 0.4, [(kicker.upper(), 11, True, COLORS["accent"])])
+        text(s, 0.8, 0.75, 11.7, 0.8, [(title, 26, True, COLORS["primary"])])
+        if subtitle:
+            text(s, 0.8, 1.4, 11.7, 0.4, [(subtitle, 13, False, COLORS["muted"])])
+        text(s, 0.8, 7.0, 11.7, 0.3, [(f"FINCH  |  {filename}  |  {today}  |  Page {page['n'] + 1}", 9, False, COLORS["muted"])])
+        return s
+
+    def style_chart(chart, as_line=False):
+        chart.has_legend = False
+        chart.has_title = False
+        chart.value_axis.has_major_gridlines = True
+        chart.value_axis.major_gridlines.format.line.color.rgb = RGBColor(226, 232, 240)
+        chart.value_axis.tick_labels.number_format = "#,##0"
+        chart.value_axis.tick_labels.number_format_is_linked = False
+        chart.value_axis.tick_labels.font.size = Pt(11)
+        chart.category_axis.tick_labels.font.size = Pt(11)
+        plot = chart.plots[0]
+        plot.has_data_labels = True
+        dl = plot.data_labels
+        dl.number_format = "#,##0"
+        dl.number_format_is_linked = False
+        dl.font.size = Pt(11)
+        dl.position = XL_LABEL_POSITION.ABOVE if as_line else XL_LABEL_POSITION.OUTSIDE_END
+        ser = plot.series[0]
+        if as_line:
+            ser.smooth = False
+            ser.format.line.color.rgb = COLORS["accent"]
+            ser.format.line.width = Pt(3)
+        else:
+            ser.format.fill.solid()
+            ser.format.fill.fore_color.rgb = COLORS["accent"]
+
+    # 1. Title
+    s1 = prs.slides.add_slide(blank)
+    background(s1, COLORS["bg_dark"])
+    text(s1, 1.0, 2.2, 11.3, 3.5, [
+        ("FINCH BUSINESS REPORT", 14, True, COLORS["gold"]),
+        (f"Sales & profit review: {filename}", 34, True, COLORS["light_text"]),
+        (f"Prepared {today}  |  Net margin: {margin_str}  |  {meta.get('total_records', 0):,} records", 16, False, COLORS["muted"]),
+    ])
+
+    # 2. Summary cards
+    s2 = new_slide("Core metrics", "Money in, money out, what you keep",
+                   "Totals calculated from the columns you selected.")
+    cards = [
+        ("TOTAL REVENUE", _money(totals.get("total_revenue", 0), currency), "Money in", COLORS["primary"], COLORS["card_bg"], False),
+        ("TOTAL COSTS", _money(totals.get("total_costs"), currency) if cost_known else "Not provided",
+         "Money spent" if cost_known else "Add a cost column to see profit", COLORS["primary"], COLORS["card_bg"], False),
+        ("NET PROFIT", _money(totals.get("net_profit"), currency) if cost_known else "n/a",
+         f"{margin_str} margin" if cost_known else "Needs costs", COLORS["success"], COLORS["primary"], True),
+    ]
+    for i, (label, value, sub, vcolor, bg, dark) in enumerate(cards):
+        shape = s2.shapes.add_shape(MSO_SHAPE.ROUNDED_RECTANGLE, Inches(0.8 + i * 4.0), Inches(2.3), Inches(3.6), Inches(3.2))
+        shape.fill.solid()
+        shape.fill.fore_color.rgb = bg
+        shape.line.fill.background()
+        tf = shape.text_frame
+        tf.word_wrap = True
+        tf.margin_left = Inches(0.3)
+        tf.margin_top = Inches(0.5)
+        for j, (txt, size, bold, color) in enumerate([
+            (label, 12, True, RGBColor(148, 163, 184) if dark else COLORS["muted"]),
+            (value, 28, True, vcolor),
+            (sub, 13, True, COLORS["success"] if dark else COLORS["accent"]),
+        ]):
+            p = tf.paragraphs[0] if j == 0 else tf.add_paragraph()
+            p.text = txt
+            p.font.size, p.font.bold, p.font.color.rgb = Pt(size), bold, color
+            p.space_after = Pt(12)
+            p.alignment = PP_ALIGN.LEFT
+
+    # 3. Categories
+    conc = facts.get("concentration", {}) or {}
+    s3 = new_slide("What sells", "Top revenue categories",
+                   conc.get("share") if rbc else "No category column was selected.")
+    if rbc:
+        top = list(rbc.items())[:6]
+        cd = CategoryChartData()
+        cd.categories = [str(k) for k, _ in top]
+        cd.add_series("Revenue", tuple(v for _, v in top))
+        gf = s3.shapes.add_chart(XL_CHART_TYPE.COLUMN_CLUSTERED, Inches(0.8), Inches(2.0), Inches(11.7), Inches(4.8), cd)
+        style_chart(gf.chart)
+
+    # 4. Trend
+    points = trend.get("points", [])
+    sub = "Add a date column to see how sales change over time."
+    if points:
+        chg = trend.get("change_pct")
+        sub = f"Latest month vs previous: {chg:+.1f}%" if chg is not None else f"Revenue by {trend.get('granularity', 'period').lower()}."
+    s4 = new_slide("Over time", "Revenue trend", sub)
+    if points:
+        cd = CategoryChartData()
+        cd.categories = [str(p["period"]) for p in points]
+        cd.add_series("Revenue", tuple(p["revenue"] for p in points))
+        gf = s4.shapes.add_chart(XL_CHART_TYPE.LINE_MARKERS, Inches(0.8), Inches(2.0), Inches(11.7), Inches(4.8), cd)
+        style_chart(gf.chart, as_line=True)
+
+    # 5. Data quality
+    s5 = new_slide("Record keeping", "How reliable are your records?",
+                   "Based on empty cells, duplicate rows and unusually large entries.")
+    health = meta.get("data_health_index", 100)
+    ring = COLORS["success"] if health >= 80 else COLORS["gold"] if health >= 60 else COLORS["danger"]
+    circle = s5.shapes.add_shape(MSO_SHAPE.OVAL, Inches(1.0), Inches(2.4), Inches(3.2), Inches(3.2))
+    circle.fill.solid()
+    circle.fill.fore_color.rgb = COLORS["card_bg"]
+    circle.line.color.rgb = ring
+    circle.line.width = Pt(4)
+    tfc = circle.text_frame
+    tfc.margin_top = Inches(0.8)
+    p = tfc.paragraphs[0]
+    p.text = f"{health}%"
+    p.font.size, p.font.bold, p.font.color.rgb = Pt(44), True, ring
+    p.alignment = PP_ALIGN.CENTER
+    p2 = tfc.add_paragraph()
+    p2.text = "data quality"
+    p2.font.size, p2.font.color.rgb = Pt(13), COLORS["muted"]
+    p2.alignment = PP_ALIGN.CENTER
+    lines = [(f"Empty cells: {meta.get('missing_cells', 0):,}", 18, True, COLORS["primary"]),
+             (f"Duplicate rows: {meta.get('duplicate_rows', 0):,}", 18, True, COLORS["primary"]),
+             (f"Unusually large rows: {meta.get('anomaly_count', 0):,}", 18, True, COLORS["primary"])]
+    for w in (facts.get("warnings") or [])[:4]:
+        lines.append((f"- {w}", 13, False, COLORS["muted"]))
+    text(s5, 5.0, 2.4, 7.6, 4.2, lines)
+
+    # 6. Saved scenarios (only when the user saved some)
+    valid = [sc for sc in (scenarios or []) if isinstance(sc, dict)][:6]
+    if valid:
+        s6 = new_slide("What-if", "Your saved plans", "Each plan shows what could happen to profit if you change price, volume or costs.")
+        rows = len(valid) + 1
+        tbl = s6.shapes.add_table(rows, 4, Inches(0.8), Inches(2.1), Inches(11.7), Inches(0.5 * rows)).table
+        for c, head in enumerate(["Plan", "Revenue", "Costs", "Profit"]):
+            tbl.cell(0, c).text = head
+        for r, sc in enumerate(valid, start=1):
+            costs_txt = _money(sc.get("costs"), currency) + (" (assumed)" if sc.get("cost_assumed") else "")
+            for c, val in enumerate([str(sc.get("scenario_name", "")), _money(sc.get("revenue"), currency),
+                                     costs_txt, _money(sc.get("net_profit"), currency)]):
+                tbl.cell(r, c).text = val
+        for r in range(rows):
+            for c in range(4):
+                for para in tbl.cell(r, c).text_frame.paragraphs:
+                    para.font.size = Pt(14)
+
+    # 7. Action plan from the numbers
+    s7 = new_slide("Next steps", "What to do next", "Generated from your numbers. Review them before acting.")
+    for i, (title, desc) in enumerate(build_actions(facts)):
+        box = s7.shapes.add_shape(MSO_SHAPE.ROUNDED_RECTANGLE, Inches(0.8 + i * 3.0), Inches(2.2), Inches(2.7), Inches(4.2))
+        box.fill.solid()
+        box.fill.fore_color.rgb = COLORS["card_bg"]
+        box.line.fill.background()
+        tf = box.text_frame
+        tf.word_wrap = True
+        tf.margin_left = Inches(0.25)
+        tf.margin_top = Inches(0.3)
+        for j, (txt, size, bold, color) in enumerate([(f"0{i + 1}", 20, True, COLORS["accent"]),
+                                                      (title, 15, True, COLORS["primary"]),
+                                                      (desc, 12, False, COLORS["muted"])]):
+            p = tf.paragraphs[0] if j == 0 else tf.add_paragraph()
+            p.text = txt
+            p.font.size, p.font.bold, p.font.color.rgb = Pt(size), bold, color
+            p.alignment = PP_ALIGN.LEFT
+            p.space_after = Pt(10)
+
+    # 8. Closing + honest disclaimer
+    s8 = prs.slides.add_slide(blank)
+    background(s8, COLORS["bg_dark"])
+    text(s8, 1.5, 2.5, 10.3, 3.2, [
+        ("Report generated by FINCH", 36, True, COLORS["light_text"]),
+        ("All figures come from the file you uploaded and the columns you selected. "
+         "They have not been audited. Check them against your own books before making financial decisions.",
+         16, False, COLORS["muted"]),
+    ])
+    for para in s8.shapes[-1].text_frame.paragraphs:
+        para.alignment = PP_ALIGN.CENTER
+
+    out = io.BytesIO()
+    prs.save(out)
+    return out.getvalue()
