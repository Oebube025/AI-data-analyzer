+
+def test_european_decimal_column_is_read_consistently():
+    s = parse_numeric_series(pd.Series(["1.234,50", "2.000,00", "999,99"]))
+    assert list(s) == [1234.5, 2000.0, 999.99]
+    assert list(parse_numeric_series(pd.Series(["1,234.50", "2,000", "999"]))) == [1234.5, 2000.0, 999.0]
