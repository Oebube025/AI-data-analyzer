+
+def test_empty_cost_is_never_zero():
+    f, _ = run(pd.DataFrame({"Item": ["a", "b"], "Amount": [1, 2]}))
+    assert f["totals"]["total_costs"] is None and f["totals"]["profit_margin"] is None
